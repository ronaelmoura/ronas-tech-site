{
  "name": "ronas-tech-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=server/.env server/index.js",
    "test": "node --test server/*.test.js tests/*.test.mjs",
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "perf": "node scripts/lighthouse.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
