VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=
# ID da conta do Google Ads, formato AW-XXXXXXXXX (aba Ferramentas > Conversoes).
# Vazio = nenhuma conversao do Google Ads e disparada.
VITE_GOOGLE_ADS_ID=
# Rotulo da acao de conversao do Google Ads (a parte depois da barra no
# fragmento "gtag('event', 'conversion', {send_to: 'AW-XXXXXXXXX/ESTE_ROTULO'})"
# que o proprio Google Ads mostra ao criar a conversao). Vazio = nao dispara.
VITE_GOOGLE_ADS_CONVERSION_LABEL=
# ID numerico do Meta Pixel (Gerenciador de Eventos). Vazio = pixel nao carrega.
# Use o MESMO ID no painel da Kiwify, senao a venda nao volta para o Meta.
VITE_META_PIXEL_ID=
VITE_KIWIFY_CHECKOUT_URL=https://pay.kiwify.com.br/jliI4Lg
